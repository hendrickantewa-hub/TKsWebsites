<!-- ║   SCRIPTS                         ║ -->
<!-- ╚═══════════════════════════════════╝ -->
<script>
/* ── Page map ── */
var PM={
  home:'n-home',about:'n-about',services:'n-services',team:'n-team',
  bschool:'n-bschool',intern:'n-intern',careers:'n-careers',
  testimonials:'n-testimonials',contact:'n-contact'
};
var cur='home';

function go(id){
  if(cur===id)return;
  var old=document.getElementById('pg-'+cur);
  if(old)old.classList.remove('on');
  cur=id;
  var pg=document.getElementById('pg-'+id);
  if(pg)pg.classList.add('on');
  document.querySelectorAll('.nl[id^="n-"]').forEach(function(b){b.classList.remove('on')});
  var nb=document.getElementById(PM[id]);
  if(nb)nb.classList.add('on');
  window.scrollTo({top:0,behavior:'instant'});
  setTimeout(reveal,50);
}

/* ── Accordion ── */
function tc(id){
  var el=document.getElementById(id);
  if(el)el.classList.toggle('op');
}

/* ── Throttled scroll handler ── */
var _st=null;
window.addEventListener('scroll',function(){
  if(_st)return;
  _st=setTimeout(function(){
    _st=null;
    var y=window.scrollY;
    document.getElementById('nav').classList.toggle('sc',y>30);
    document.getElementById('btt').classList.toggle('on',y>340);
    reveal();
  },180);
},{passive:true});

document.getElementById('btt').addEventListener('click',function(){
  window.scrollTo({top:0,behavior:'smooth'});
});

/* ── Hamburger ── */
var _ham=document.getElementById('hamBtn');
var _mob=document.getElementById('mnav');
_ham.addEventListener('click',function(){
  var op=_mob.classList.toggle('op');
  _ham.classList.toggle('op',op);
  _ham.setAttribute('aria-expanded',String(op));
  document.body.style.overflow=op?'hidden':'';
});
function cm(){
  _mob.classList.remove('op');
  _ham.classList.remove('op');
  _ham.setAttribute('aria-expanded','false');
  document.body.style.overflow='';
}

/* ── IntersectionObserver scroll reveal (passive, unobserves after trigger) ── */
var _obs=new IntersectionObserver(function(entries){
  entries.forEach(function(e){
    if(e.isIntersecting){
      e.target.classList.add('vis');
      _obs.unobserve(e.target);
    }
  });
},{threshold:0.07,rootMargin:'0px 0px -10px 0px'});

function reveal(){
  var pg=document.querySelector('.pg.on');
  if(!pg)return;
  pg.querySelectorAll('.rv:not(.vis),.rvl:not(.vis),.rvr:not(.vis)').forEach(function(el){
    _obs.observe(el);
  });
}

/* ── Keyboard nav for brand ── */
document.querySelector('.brand').addEventListener('keydown',function(e){
  if(e.key==='Enter'||e.key===' ')go('home');
});

/* ── Init ── */
document.getElementById('n-home').classList.add('on');
reveal();
</script>
