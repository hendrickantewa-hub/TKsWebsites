<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>O&amp;M Accountants &amp; Consultants | Walvis Bay, Namibia</title>
<meta name="description" content="O&amp;M Accountants &amp; Consultants, professional tax, bookkeeping and payroll services in Walvis Bay and Windhoek, Namibia."/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<style>
/* ══ DESIGN TOKENS ══════════════════════════════════════ */
:root{
  --G:#C9A84C; --G2:#E8C96A; --G3:#8B6914;
  --Gp:rgba(201,168,76,.10); --Gb:rgba(201,168,76,.18);
  --K:#0D0C0A; --K2:#181612; --K3:#252320;
  --S:#68665E; --L:#E2E0D8;
  --BG:#F6F5F2; --WH:#FFFFFF; --ICE:#F0EFE9;
  --fd:'Playfair Display',Georgia,serif;
  --fb:'Inter',system-ui,sans-serif;
  --sh:0 2px 20px rgba(0,0,0,.07);
  --shm:0 8px 36px rgba(0,0,0,.11);
  --tr:.22s cubic-bezier(.4,0,.2,1);
  --r:5px; --r2:11px; --r3:18px;
}

/* ══ RESET ══════════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:16px}
body{font-family:var(--fb);color:var(--K);background:var(--BG);
  overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block;height:auto}
ul{list-style:none}
button{font-family:var(--fb);cursor:pointer;border:none;background:none}
::-webkit-scrollbar{width:3px}
::-webkit-scrollbar-thumb{background:var(--G);border-radius:2px}

/* ══ ANIMATIONS ══════════════════════════════════════════ */
@keyframes fadeUp {from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
@keyframes fadeIn {from{opacity:0}to{opacity:1}}
@keyframes pg     {from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
@keyframes hzoom  {from{transform:scale(1.06)}to{transform:scale(1.01)}}
@keyframes bob    {0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
@keyframes bar    {from{transform:scaleX(0)}to{transform:scaleX(1)}}
@keyframes fadeSlide{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:none}}

/* ══ SCROLL REVEAL ══════════════════════════════════════ */
.rv{opacity:0;transform:translateY(20px);transition:opacity .58s ease,transform .58s ease}
.rvl{opacity:0;transform:translateX(-20px);transition:opacity .58s ease,transform .58s ease}
.rvr{opacity:0;transform:translateX(20px);transition:opacity .58s ease,transform .58s ease}
.rv.vis,.rvl.vis,.rvr.vis{opacity:1;transform:none}
[class*="rv"][style*="delay"]{/* delays applied inline */}

/* ══ PAGE SYSTEM ══════════════════════════════════════════ */
.pg{display:none;padding-top:68px;min-height:100vh}
.pg.on{display:block;animation:pg .26s ease}

/* ══ NAV ═════════════════════════════════════════════════ */
#nav{
  position:fixed;top:0;left:0;right:0;z-index:900;height:68px;
  display:flex;align-items:center;justify-content:space-between;padding:0 4%;
  background:rgba(255,255,255,.98);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--L);
  transition:box-shadow var(--tr),border-color var(--tr);
}
#nav.sc{border-bottom-color:transparent;box-shadow:0 2px 28px rgba(0,0,0,.1)}
/* Brand */
.brand{display:flex;align-items:center;gap:11px;cursor:pointer;min-width:0;flex:1 1 auto;overflow:hidden}
.logo{height:44px;object-fit:contain}
.bname{font-family:var(--fd);font-size:.86rem;font-weight:600;color:var(--K);display:block;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.btag{font-size:.5rem;font-weight:700;color:var(--G3);letter-spacing:.26em;text-transform:uppercase;display:block;margin-top:1px}
/* Nav links */
.links{display:flex;align-items:center}
.nl{font-size:.71rem;font-weight:500;color:var(--S);padding:7px 9px;border-radius:var(--r2);
  position:relative;transition:color var(--tr),background var(--tr);white-space:nowrap}
.nl::after{content:'';position:absolute;bottom:3px;left:9px;right:9px;height:1.5px;
  background:var(--G);border-radius:1px;transform:scaleX(0);transform-origin:left;transition:transform var(--tr)}
.nl:hover{color:var(--K);background:var(--ICE)}
.nl.on,.nl:focus-visible{color:var(--K);font-weight:600}
.nl.on::after{transform:scaleX(1)}
.nl-cta{background:var(--K)!important;color:var(--WH)!important;font-weight:600!important;
  border-radius:var(--r2)!important;padding:8px 15px!important;margin-left:5px;
  transition:background var(--tr)!important}
.nl-cta::after{display:none!important}
.nl-cta:hover{background:var(--K2)!important}
/* Ham */
.ham{display:none;flex-direction:column;gap:5px;padding:12px;flex-shrink:0;min-width:44px;min-height:44px;justify-content:center;align-items:center}
.ham span{display:block;width:20px;height:1.5px;background:var(--K);border-radius:1px;transition:var(--tr)}
.ham.op span:nth-child(1){transform:rotate(45deg) translate(4px,4px)}
.ham.op span:nth-child(2){opacity:0}
.ham.op span:nth-child(3){transform:rotate(-45deg) translate(4px,-4px)}
/* Mobile nav */
.mnav{display:none;position:fixed;inset:68px 0 0 0;
  background:rgba(255,255,255,.99);z-index:899;
  flex-direction:column;align-items:center;justify-content:center;
  gap:4px;animation:fadeIn .16s ease;padding:20px 0;overflow-y:auto}
.mnav.op{display:flex}
.mnav .nl{font-size:.95rem;padding:12px 32px;width:min(280px,84vw);text-align:center;border-radius:var(--r2)}
.mnav .nl-cta{margin:8px 0 0!important;width:min(220px,70vw);text-align:center}

/* ══ LAYOUT ══════════════════════════════════════════════ */
.w{max-width:1200px;margin:0 auto;padding:0 4%}
.sec{padding:88px 4%}
.dark{background:var(--K2)}
.mist{background:var(--ICE)}
.white{background:var(--WH)}
.gold{background:var(--G)}
/* Page header dark band */
.hdr{padding:68px 4% 60px;background:var(--K2)}
.hdr-in{max-width:680px}

/* ══ TYPOGRAPHY ══════════════════════════════════════════ */
.ey{font-size:.62rem;font-weight:700;letter-spacing:.3em;text-transform:uppercase;
  color:var(--G3);display:block;margin-bottom:12px}
.ey.lt{color:rgba(201,168,76,.78)!important}
.rule{width:32px;height:2px;background:var(--G);border-radius:1px;margin:14px 0 28px}
.rule.c{margin-left:auto;margin-right:auto}
h2.H{font-family:var(--fd);font-size:clamp(1.7rem,3.3vw,2.7rem);font-weight:600;line-height:1.16;color:var(--K)}
h2.H.lt{color:var(--WH)}
.lead{font-size:.91rem;color:var(--S);line-height:1.84;max-width:520px}
.lead.lt{color:rgba(255,255,255,.56)}

/* ══ BUTTONS ══════════════════════════════════════════════ */
.btn{display:inline-flex;align-items:center;gap:7px;padding:11px 22px;
  border-radius:var(--r2);font-size:.8rem;font-weight:600;
  transition:all var(--tr);cursor:pointer;border:none;font-family:var(--fb);white-space:nowrap}
.bk{background:var(--K);color:var(--WH)}
.bk:hover{background:var(--K2);transform:translateY(-1px);box-shadow:0 4px 14px rgba(0,0,0,.22)}
.bg{background:var(--G);color:var(--K)}
.bg:hover{background:var(--G2);transform:translateY(-1px);box-shadow:0 4px 14px rgba(201,168,76,.38)}
.bo{background:transparent;color:var(--K);border:1.5px solid var(--K)}
.bo:hover{background:var(--K);color:var(--WH)}
.bo-lt{background:transparent;color:var(--WH);border:1.5px solid rgba(255,255,255,.38)}
.bo-lt:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.65)}

/* ══ HERO ═════════════════════════════════════════════════ */
.hero{
  position:relative;height:100vh;min-height:560px;max-height:940px;
  display:flex;align-items:flex-end;overflow:hidden;background:var(--K2);
}
@supports(height:100svh){.hero{height:100svh}}
/* BG image — CSS only, no JS scroll handler */
.hbg{
  position:absolute;inset:-3%;
  background:url('images/image-001.jpg') center 35%/cover no-repeat;
  animation:hzoom 10s ease-out forwards;
  will-change:transform;
}
.hfilm{position:absolute;inset:0;background:linear-gradient(to right,rgba(13,12,10,.52) 0%,rgba(13,12,10,.26) 45%,transparent 80%);pointer-events:none}
.hfade{position:absolute;bottom:0;left:0;right:0;height:200px;background:linear-gradient(to top,rgba(13,12,10,.38),transparent);pointer-events:none}
.hedge{position:absolute;inset:0;box-shadow:inset 0 0 80px rgba(13,12,10,.18);pointer-events:none}
.hinner{position:relative;z-index:2;width:100%;padding:clamp(36px,6vh,88px) clamp(18px,4vw,56px) clamp(28px,5vh,64px)}
.h-eyebrow{display:flex;align-items:center;gap:8px;font-size:.68rem;letter-spacing:.36em;text-transform:uppercase;
  color:rgba(255,255,255,.34);margin-bottom:18px;animation:fadeUp .5s .06s both}
.h-eyebrow::before{content:'';width:22px;height:1px;background:var(--G);display:block;flex-shrink:0}
.h-firm{font-family:var(--fd);font-size:clamp(2rem,5.5vw,4.2rem);
  color:var(--WH);font-weight:700;line-height:1.06;
  max-width:640px;animation:fadeUp .5s .14s both}
.h-tag{font-size:.68rem;font-weight:700;letter-spacing:.38em;text-transform:uppercase;
  color:var(--G);display:block;margin:10px 0 18px;
  animation:fadeUp .5s .2s both;opacity:.88}
.h-sub{font-size:.88rem;color:rgba(255,255,255,.5);line-height:1.84;
  max-width:440px;margin-bottom:32px;animation:fadeUp .5s .28s both;font-weight:300}
.h-cta{display:flex;gap:11px;flex-wrap:wrap;animation:fadeUp .5s .36s both;margin-bottom:44px}
/* KPI strip */
.h-kpi{display:flex;width:fit-content;
  border-top:1px solid rgba(255,255,255,.1);padding-top:24px;
  animation:fadeUp .5s .44s both}
.kpi{padding:0 28px 0 0}
.kpi+.kpi{padding-left:28px;border-left:1px solid rgba(255,255,255,.1)}
.kpi strong{display:block;font-family:var(--fd);font-size:1.9rem;color:var(--G);
  font-weight:600;line-height:1;margin-bottom:3px}
.kpi span{font-size:.58rem;color:rgba(255,255,255,.34);font-weight:500;
  letter-spacing:.13em;text-transform:uppercase}

/* ══ SERVICES GRID ════════════════════════════════════════ */
/* Grey tiles with hover animations */
.sg{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;
  background:var(--L);border:1px solid var(--L);border-radius:var(--r3);
  overflow:hidden;margin-top:48px}
.si{background:var(--ICE);padding:32px 26px;position:relative;overflow:hidden;
  cursor:default;transition:background var(--tr)}
.si::before{content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,transparent 60%,rgba(201,168,76,.05) 100%);
  opacity:0;transition:opacity var(--tr)}
.si::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2.5px;
  background:var(--G);transform:scaleX(0);transform-origin:left;
  transition:transform .32s ease}
.si:hover{background:#ECEAE5}
.si:hover::before{opacity:1}
.si:hover::after{transform:scaleX(1)}
.si:hover .sin{color:rgba(201,168,76,.5)}
.sin{font-family:var(--fd);font-size:1.5rem;color:rgba(201,168,76,.25);
  font-weight:700;display:block;line-height:1;margin-bottom:9px;transition:color var(--tr)}
.sib{width:22px;height:2px;background:var(--G);border-radius:1px;
  margin-bottom:13px;transform-origin:left}
.si h3{font-family:var(--fd);font-size:.96rem;font-weight:600;margin-bottom:7px;color:var(--K)}
.si p{font-size:.78rem;color:var(--S);line-height:1.64}

/* Accordion */
.ac{background:var(--ICE);border:1px solid var(--L);border-radius:var(--r2);
  margin-bottom:2px;overflow:hidden;transition:box-shadow var(--tr)}
.ac:hover{box-shadow:var(--sh)}
.ac-hdr{display:flex;align-items:center;justify-content:space-between;
  padding:17px 20px;cursor:pointer;user-select:none;transition:background var(--tr);min-height:44px}
.ac-hdr:hover{background:#E8E6E0}
.ac-hdr h3{font-family:var(--fd);font-size:.96rem;font-weight:600;color:var(--K);
  display:flex;align-items:center;gap:12px}
.ac-ico{width:34px;height:34px;background:var(--Gb);border-radius:var(--r);
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;font-size:.74rem;font-weight:700;color:var(--G3);font-family:var(--fd)}
.ac-arr{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--L);
  display:flex;align-items:center;justify-content:center;
  font-size:.63rem;color:var(--S);flex-shrink:0;
  transition:transform var(--tr),border-color var(--tr),color var(--tr)}
.ac.op .ac-arr{transform:rotate(180deg);border-color:var(--G);color:var(--G3)}
.ac-bd{display:none;padding:0 20px 18px;border-top:1px solid var(--L)}
.ac.op .ac-bd{display:block}
.sub{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:12px}
.subi{padding:10px 13px;background:var(--WH);border-radius:var(--r);
  border-left:3px solid var(--G);font-size:.78rem;color:var(--K);
  font-weight:500;line-height:1.38}
.stag{display:inline-block;background:var(--Gb);color:var(--G3);
  font-size:.57rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  padding:2px 6px;border-radius:50px;margin-left:4px;vertical-align:middle}

/* ══ ABOUT SPLIT ══════════════════════════════════════════ */
.asplit{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center}
.aiw{position:relative}
.aimg{width:100%;aspect-ratio:3/4;object-fit:cover;object-position:center top;
  border-radius:var(--r3);box-shadow:var(--shm)}
.abadge{position:absolute;bottom:-14px;right:-14px;background:var(--G);
  color:var(--K);border-radius:var(--r2);padding:14px 18px;text-align:center;
  box-shadow:0 6px 22px rgba(201,168,76,.35)}
.abadge strong{display:block;font-family:var(--fd);font-size:1.75rem;font-weight:700;line-height:1}
.abadge small{font-size:.59rem;font-weight:700;text-transform:uppercase;letter-spacing:.14em}
.wbadge{display:inline-flex;align-items:center;gap:7px;
  background:rgba(201,168,76,.09);border:1px solid rgba(201,168,76,.26);
  color:var(--G3);font-size:.67rem;font-weight:700;letter-spacing:.1em;
  text-transform:uppercase;padding:6px 13px;border-radius:50px;margin-bottom:18px}
.wbadge::before{content:'';width:12px;height:2px;background:var(--G);border-radius:1px;flex-shrink:0}
.vals{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:24px}
.val{padding:14px;border:1px solid var(--L);border-radius:var(--r2);
  border-left:3px solid var(--G);background:var(--WH)}
.val h4{font-size:.8rem;font-weight:700;color:var(--K);margin-bottom:3px}
.val p{font-size:.73rem;color:var(--S);line-height:1.52}

/* ══ STATS BAND ══════════════════════════════════════════ */
.sb{display:grid;grid-template-columns:repeat(4,1fr);background:var(--K)}
.sbc{padding:36px;border-right:1px solid rgba(255,255,255,.07);text-align:center}
.sbc:last-child{border-right:none}
.sbn{font-family:var(--fd);font-size:2.2rem;color:var(--G);
  font-weight:700;display:block;line-height:1;margin-bottom:6px}
.sbl{font-size:.61rem;font-weight:600;letter-spacing:.18em;
  text-transform:uppercase;color:rgba(255,255,255,.36)}

/* ══ PEOPLE MOSAIC ════════════════════════════════════════ */
/* Smart image grid — used on home, about and team pages */
.mosaic-2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.mosaic-3{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:14px}
.pic{border-radius:var(--r3);overflow:hidden;position:relative}
.pic img{width:100%;height:100%;object-fit:cover;display:block;
  transition:transform .5s ease;will-change:transform}
.pic:hover img{transform:scale(1.04)}
.pic-lbl{position:absolute;bottom:0;left:0;right:0;
  padding:20px 16px 13px;
  background:linear-gradient(transparent,rgba(13,12,10,.78));
  color:rgba(255,255,255,.82);font-size:.72rem;font-weight:500}
/* Aspect ratios */
.pic-land{aspect-ratio:4/3}
.pic-port{aspect-ratio:3/4}
.pic-wide{aspect-ratio:16/7}
.pic-sq  {aspect-ratio:1}

/* ══ TEAM ═════════════════════════════════════════════════ */
.founders{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.fc{position:relative;overflow:hidden;border-radius:var(--r3);aspect-ratio:3/4}
.fc img{width:100%;height:100%;object-fit:cover;object-position:center top;
  display:block;transition:transform .55s ease;will-change:transform}
.fc:hover img{transform:scale(1.04)}

footer .fg .fc{overflow:visible;aspect-ratio:auto;border-radius:0;position:static;height:auto}
.fveil{position:absolute;inset:0;
  background:linear-gradient(to top,rgba(13,12,10,.94) 0%,rgba(13,12,10,.26) 52%,transparent 100%)}
.finfo{position:absolute;bottom:0;left:0;right:0;padding:24px 22px}
.finfo h3{font-family:var(--fd);font-size:1.32rem;color:var(--WH);
  margin-bottom:3px;font-weight:600}
.frole{font-size:.6rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;
  color:var(--G);display:block;margin-bottom:10px}
.finfo p{font-size:.78rem;color:rgba(255,255,255,.64);line-height:1.62;margin-bottom:12px}
.fls{display:flex;gap:7px;flex-wrap:wrap}
.fl{font-size:.66rem;font-weight:600;color:var(--G);
  border:1px solid rgba(201,168,76,.32);padding:4px 10px;
  border-radius:50px;transition:all var(--tr)}
.fl:hover{background:var(--G);color:var(--K)}
/* Staff divider */
.sdiv{display:flex;align-items:center;gap:16px;margin:44px 0 28px}
.sdiv::before,.sdiv::after{content:'';flex:1;height:1px;background:var(--L)}
.sdivl{font-size:.61rem;font-weight:700;letter-spacing:.26em;
  text-transform:uppercase;color:var(--S);white-space:nowrap}
/* Culture grid */
.cg{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}
.cc{border:1px solid var(--L);border-radius:var(--r2);padding:20px 16px;
  background:var(--WH);border-top:3px solid var(--G)}
.cc h4{font-size:.8rem;font-weight:700;color:var(--K);margin-bottom:4px}
.cc p{font-size:.73rem;color:var(--S);line-height:1.56}

/* ══ BUSINESS SCHOOL ══════════════════════════════════════ */
.bsh{display:grid;grid-template-columns:1fr 1fr;background:var(--K2);min-height:480px}
.bsl{padding:72px 4%;display:flex;flex-direction:column;justify-content:center;max-width:600px}
.bsr{position:relative;overflow:hidden}
.bsr img{width:100%;height:100%;object-fit:cover;object-position:center}
.bsr::before{content:'';position:absolute;inset:0;z-index:1;
  background:linear-gradient(to right,var(--K2) 0%,transparent 52%)}
.cgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-top:32px}
.ccard{background:var(--ICE);border:1px solid var(--L);border-radius:var(--r3);
  padding:22px;transition:all var(--tr);position:relative;overflow:hidden}
.ccard::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;
  background:var(--G);transform:scaleX(0);transform-origin:left;transition:transform .3s ease}
.ccard:hover{border-color:rgba(201,168,76,.36);
  box-shadow:0 4px 20px rgba(201,168,76,.13);transform:translateY(-2px)}
.ccard:hover::after{transform:scaleX(1)}
.badge{display:inline-block;font-size:.58rem;font-weight:700;letter-spacing:.14em;
  text-transform:uppercase;padding:3px 9px;border-radius:50px;margin-bottom:11px}
.ba{background:#fffbeb;color:#92400e}
.bb{background:#eff6ff;color:#1e40af}
.bc{background:#f0fdf4;color:#166534}
.bd2{background:#fff1f2;color:#9f1239}
.ccard h3{font-family:var(--fd);font-size:.94rem;font-weight:600;color:var(--K);margin-bottom:6px}
.ccard p{font-size:.76rem;color:var(--S);line-height:1.6;margin-bottom:10px}
.cmeta{font-size:.68rem;color:var(--S);font-weight:500;display:flex;gap:10px}
/* Admission box */
.admbox{background:var(--K);border-radius:var(--r3);padding:32px 36px;
  margin-top:14px;display:flex;align-items:center;
  justify-content:space-between;flex-wrap:wrap;gap:18px}
.admbox h3{font-family:var(--fd);font-size:1.25rem;color:var(--WH);margin-bottom:6px}
.admbox p{font-size:.79rem;color:rgba(255,255,255,.52);line-height:1.62;max-width:420px}

/* ══ INTERNSHIP ═══════════════════════════════════════════ */
/* Split hero for internship */
.isplit{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
.unis{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:40px 0}
